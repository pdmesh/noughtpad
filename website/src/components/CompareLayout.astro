---
import Base from "../layouts/Base.astro";
import DownloadCta from "./DownloadCta.astro";
import { COMPARISONS_CHECKED, SITE_URL } from "../config";

interface Props {
  title: string;
  description: string;
  h1: string;
  /** The other app's name, for structured data. */
  other: string;
  /** The other app's main domain, named once at the foot of the page, e.g. "obsidian.md". */
  site: string;
}
const { title, description, h1, other, site } = Astro.props;
const checked = COMPARISONS_CHECKED.replace(/^\d+\s+/, "");
const crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Compare", item: `${SITE_URL}/compare/` },
    { "@type": "ListItem", position: 2, name: `Noughtpad vs ${other}`, item: new URL(Astro.url.pathname, SITE_URL).href },
  ],
};
const article = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: h1,
  description,
  dateModified: "2026-11-04",
  author: { "@type": "Organization", name: "Noughtpad" },
};
---

<Base title={title} description={description} section="compare" jsonld={[crumbs, article]}>
  <article class="page">
    <div class="wrap prose">
      <p class="crumb"><a href="/compare/">Compare</a></p>
      <h1>{h1}</h1>
      <slot />
      <p class="fine">Prices and features of {other} as listed on <a href={`https://${site}`}>{site}</a>, {checked}.</p>
      <hr />
      <h2>Try Noughtpad</h2>
      <p>It's free, it works without an account, and your notes stay plain Markdown files. If it isn't for you, the files open in any other Markdown app.</p>
      <DownloadCta />
      <p class="muted small">More comparisons: <a href="/compare/">all comparisons</a>.</p>
    </div>
  </article>
</Base>
