---
import { SITE_NAME, SITE_URL, SOURCE_URL } from "../config";
import "@fontsource-variable/literata/opsz.css";
import "../styles/global.css";

interface Props {
  /** Page title, without the site name. */
  title: string;
  description: string;
  /** Social card image, relative to the site root. */
  image?: string;
  imageAlt?: string;
  /** Extra structured data (JSON-LD objects). */
  jsonld?: object[];
  /** Mark a nav item as current. */
  section?: "features" | "guide" | "compare" | "download";
  /** Keep this page out of search results (legal pages, 404). */
  noindex?: boolean;
}

const { noindex = false, title, description, image = "/img/og.png", imageAlt = "The Noughtpad app: a quiet writing page with related notes beside it.", jsonld = [], section } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const imageUrl = new URL(image, SITE_URL).href;
const nav = [
  { href: "/features/", label: "Features", key: "features" },
  { href: "/guide/", label: "Guide", key: "guide" },
  { href: "/compare/", label: "Compare", key: "compare" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fcfcfa" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {jsonld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href="/" aria-label="Noughtpad home">
          <img src="/favicon.svg" width="26" height="26" alt="" />
          <span>Noughtpad</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={n.href} aria-current={section === n.key ? "page" : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
            {SOURCE_URL && (
              <li>
                <a class="gh" href={SOURCE_URL} aria-label="Noughtpad on GitHub" title="Source on GitHub">
                  <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                </a>
              </li>
            )}
            <li><a class="btn btn-small" href="/download/" aria-current={section === "download" ? "page" : undefined}>Download</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="brand"><img src="/favicon.svg" width="22" height="22" alt="" /> <span>Noughtpad</span></p>
          <p class="muted">A private notebook for Mac, Windows and Linux. Your notes stay plain Markdown files on your own computer.</p>
          {SOURCE_URL && <p class="muted"><a href={SOURCE_URL}>Source available on GitHub</a></p>}
        </div>
        <div>
          <h2 class="footer-h">Product</h2>
          <ul>
            <li><a href="/features/">Features</a></li>
            <li><a href="/download/">Download</a></li>
            <li><a href="/guide/">User guide</a></li>
            <li><a href="/guide/common-problems/">Common problems</a></li>
          </ul>
        </div>
        <div>
          <h2 class="footer-h">Compare</h2>
          <ul>
            <li><a href="/noughtpad-vs-obsidian/">Noughtpad vs Obsidian</a></li>
            <li><a href="/obsidian-alternative/">An Obsidian alternative</a></li>
            <li><a href="/noughtpad-vs-notion/">Noughtpad vs Notion</a></li>
            <li><a href="/noughtpad-vs-logseq/">Noughtpad vs Logseq</a></li>
            <li><a href="/noughtpad-vs-bear/">Noughtpad vs Bear</a></li>
            <li><a href="/noughtpad-vs-apple-notes/">Noughtpad vs Apple Notes</a></li>
            <li><a href="/noughtpad-vs-evernote/">Noughtpad vs Evernote</a></li>
          </ul>
        </div>
        <div>
          <h2 class="footer-h">Support</h2>
          <ul>
            <li><a href="/contact/">Contact us</a></li>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/terms/">Terms</a></li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
