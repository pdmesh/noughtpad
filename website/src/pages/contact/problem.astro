---
import Base from "../../layouts/Base.astro";
---

<Base title="Message not sent" description="Your message to Noughtpad couldn't be sent. Check your email address and message, then try the contact form again." noindex>
  <div class="page">
    <div class="wrap prose">
      <h1>Your message wasn't sent</h1>
      <p class="lede">Please check that your email address looks right and that the message isn't empty, then try again.</p>
      <p><a href="/contact/">Back to the contact form</a></p>
      <p class="muted small">If it keeps happening, the problem is on our side. Please try again later.</p>
    </div>
  </div>
</Base>
