---
import Base from "../layouts/Base.astro";
import { RELEASES_URL, VERSION, SITE_URL } from "../config";

const app = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Noughtpad",
  applicationCategory: "ProductivityApplication",
  operatingSystem: "macOS (Apple Silicon), Windows, Linux",
  softwareVersion: VERSION,
  downloadUrl: RELEASES_URL,
  url: SITE_URL + "/download/",
  image: SITE_URL + "/img/og.png",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Base
  title="Download Noughtpad for Mac, Windows and Linux"
  description={`Download Noughtpad ${VERSION}, a free Markdown notes app for Mac (Apple Silicon), Windows and Linux. No account needed; your notes stay on your computer.`}
  section="download"
  jsonld={[app]}
>
  <div class="page">
    <div class="wrap">
      <div class="prose">
        <h1>Download Noughtpad</h1>
        <p class="lede">Free, with no account. Version {VERSION}, now in beta. <a href={RELEASES_URL}>What's new</a></p>
      </div>

      <ul class="platforms">
        <li id="mac-card">
          <h2>Mac</h2>
          <p>For Apple Silicon Macs (M1 and later). Choose the file ending in <code>aarch64.dmg</code>.</p>
          <a class="btn" href={RELEASES_URL}>Download for Mac</a>
        </li>
        <li>
          <h2>Windows</h2>
          <p>Choose the file ending in <code>setup.exe</code>. It installs just for you, with no admin rights needed. An <code>.msi</code> is there too.</p>
          <a class="btn" href={RELEASES_URL}>Download for Windows</a>
        </li>
        <li>
          <h2>Linux</h2>
          <p>Choose the <code>.AppImage</code>, or the <code>.deb</code> (Debian, Ubuntu) or <code>.rpm</code> (Fedora) package.</p>
          <a class="btn" href={RELEASES_URL}>Download for Linux</a>
        </li>
      </ul>
      <p class="fine">Downloads come from Noughtpad's release page on GitHub. Look under "Assets" for your file.</p>
    </div>

    <div class="wrap prose">
      <h2 id="mac">Installing</h2>
      <p>
        <strong>Mac:</strong> open the <code>.dmg</code> and drag Noughtpad into Applications. During the beta, macOS asks you to confirm the app the first time you open it. <a href="/guide/install-and-first-note/#first-open-mac">Here's the one-time step</a>.
      </p>
      <p id="windows">
        <strong>Windows:</strong> run the installer. If Windows shows "Windows protected your PC", click <strong>More info</strong>, then <strong>Run anyway</strong>.
      </p>
      <p id="linux">
        <strong>Linux:</strong> make the AppImage executable (<code>chmod +x</code>, or "Allow executing file as program" in its properties) and open it. The <code>.deb</code> and <code>.rpm</code> install like any other package.
      </p>

      <h2>After installing</h2>
      <ul>
        <li>Noughtpad asks where to keep your notes, then opens on a blank page. <a href="/guide/install-and-first-note/">Your first note, step by step</a></li>
        <li>It checks for updates by itself and shows an "Update to …" button in the sidebar when one is ready. Nothing downloads until you click it. <a href="/guide/updating/">About updates</a></li>
      </ul>

      <h2>What you need</h2>
      <ul>
        <li>A Mac with Apple Silicon, or a Windows or Linux computer. The app is about 60 MB.</li>
        <li>Optional: about 65 MB more for search by meaning, and 1.1 to 2.5 GB if you want a chat model that runs on your own computer.</li>
      </ul>
      <p>Something not working? <a href="/guide/common-problems/">Common problems</a>, or <a href="/contact/">write to us</a>.</p>
    </div>
  </div>
</Base>
