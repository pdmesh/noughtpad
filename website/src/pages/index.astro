---
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import DownloadCta from "../components/DownloadCta.astro";
import { SITE_URL, VERSION, RELEASES_URL } from "../config";

const app = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Noughtpad",
  applicationCategory: "ProductivityApplication",
  operatingSystem: "macOS (Apple Silicon), Windows, Linux",
  softwareVersion: VERSION,
  description:
    "A private notes app. Write on a blank page; every note is saved as a plain Markdown file on your computer. Related notes, search by meaning and ideas over time run on your computer.",
  url: SITE_URL + "/",
  downloadUrl: RELEASES_URL,
  image: SITE_URL + "/img/og.png",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
const site = { "@context": "https://schema.org", "@type": "WebSite", name: "Noughtpad", url: SITE_URL + "/" };
---

<Base
  title="Noughtpad: private Markdown notes that find each other"
  description="Noughtpad is a free notes app for Mac, Windows and Linux. Write on a blank page, keep every note as a Markdown file on your computer, and see which notes connect and how your ideas change."
  jsonld={[app, site]}
>
  <section class="hero">
    <div class="wrap">
      <h1>A blank page that quietly remembers<span class="caret" aria-hidden="true"></span></h1>
      <p class="lede">
        Write the way you think. Noughtpad keeps every note as a plain Markdown file on your computer, then shows you which notes belong together and how your thinking has changed.
      </p>
      <DownloadCta />
      <div class="hero-media">
        <div class="frame">
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            width="1920"
            height="1080"
            poster="/video/demo-poster.webp"
            aria-label="A short demo: a note is typed on a blank page, then related notes, ideas over time, the journal and a chat with the notes appear in turn."
          >
            <source src="/video/demo.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2>Open it and write</h2>
        <p>
          No titles, folders or templates to set up first. Noughtpad opens on an empty page with the cursor ready, and saves as you type. The sidebar stays out of sight until you reach for it.
        </p>
        <p>
          Press <kbd>⌘</kbd> <kbd>⇧</kbd> <kbd>Space</kbd> in any app to start a new note. On Windows and Linux it's <kbd>Ctrl</kbd> <kbd>Shift</kbd> <kbd>Space</kbd>.
        </p>
      </div>
      <Shot name="write" alt="The Noughtpad writing page: two lines of text on an otherwise empty page, with no toolbar or sidebar showing." />
    </div>
  </section>

  <section class="section">
    <div class="wrap split flip">
      <div>
        <h2>Old notes come back when they matter</h2>
        <p>
          Open any note and press <kbd>⌘</kbd> <kbd>J</kbd>. Noughtpad finds earlier notes on the same idea, even when they use different words, and shows the exact passage that matched.
        </p>
        <p>
          A thought from March sits next to the one you wrote today. Mark a suggestion "Not related" and it won't come back, and the suggestions get better as you use them.
        </p>
      </div>
      <Shot name="related" alt="A note about a venture capital framework, with a Related panel on the right listing three earlier notes on ownership and fund returns, each with the matching passage." />
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2>Watch an idea grow</h2>
        <p>
          Ideas over time gathers your notes into threads and lays them out month by month: what you keep coming back to, what's just starting, what you set aside, and the books and articles that shaped it.
        </p>
        <p>
          It's all worked out on your computer from your own words. Nothing is written for you.
        </p>
      </div>
      <Shot name="thread" alt="A thread called read, power, return, showing 10 notes over 8 months, laid out by month, with cues such as May build on Venture Deals and Asks a question." />
    </div>
  </section>

  <section class="section">
    <div class="wrap split flip">
      <div>
        <h2>Ask your notes</h2>
        <p>
          Ask how your view on something has changed, or what last spring was really about. Every answer points to the notes it came from.
        </p>
        <p>
          Run a free model on your own computer, fully offline. Or bring your own Anthropic, OpenAI or Gemini account, or Ollama. Before any note goes online, Noughtpad shows you which ones and asks.
        </p>
      </div>
      <Shot name="chat" alt="A chat asking how the writer's thinking on ownership changed this year. The answer cites two notes by number, and the model is shown as running on this computer." />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="intro">
        <h2>Plain files. Nothing locked in.</h2>
        <p>
          Every note is a Markdown file in a folder you choose. Open it in any editor, back it up however you like, or keep it in git. Your notes are yours in the most literal sense.
        </p>
      </div>
      <ul class="points">
        <li>
          <h3>Works alongside Obsidian</h3>
          <p>Point both apps at the same folder and edits in one show up in the other. <a href="/noughtpad-vs-obsidian/">See how they compare</a></p>
        </li>
        <li>
          <h3>No account</h3>
          <p>Download it and start writing. Nothing asks you to sign up.</p>
        </li>
        <li>
          <h3>Private by default</h3>
          <p>Search, related notes and ideas over time all run on your computer.</p>
        </li>
        <li>
          <h3>Fast with thousands of notes</h3>
          <p>Tested with 10,000 notes. Search answers in milliseconds.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="intro">
        <h2>Everything else a notebook needs</h2>
      </div>
      <ul class="points">
        <li><h3>Search by meaning</h3><p><kbd>⌘</kbd> <kbd>K</kbd> finds notes by their words and by what they mean. "Getting fit" finds your running notes.</p></li>
        <li><h3>Journal and activity map</h3><p>Your notes by day, week or month, and a year of writing at a glance. No streaks to keep up.</p></li>
        <li><h3>Labels and sources</h3><p>As many labels as you like, and a place to note the book, article or talk an idea came from.</p></li>
        <li><h3>Clean paste</h3><p>Paste from a web page, Google Docs or Word and get tidy Markdown. Images are saved next to your notes.</p></li>
        <li><h3>Diagrams and maths</h3><p>Mermaid diagrams and LaTeX maths render as you write.</p></li>
        <li><h3>Sync across computers</h3><p>Keep your notebook in step through your own Google Drive. Now in beta, by invitation. <a href="/features/#sync">Learn more</a></p></li>
      </ul>
    </div>
  </section>

  <section class="closing">
    <div class="wrap">
      <h2>Your next good idea is probably already in your notes.</h2>
      <DownloadCta />
    </div>
  </section>
</Base>
